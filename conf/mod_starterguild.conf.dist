[worldserver]

#
#   StarterGuild.Enable
#       Description: Description: Enable or disable the module
#       Default: 1
#       Value:
#           0 (false)
#           1 (true)
#

StarterGuild.Enable = 1

#
#   StarterGuild.Announce
#       Description: Enable or disable the announcement that you are using the module
#       Default: 0
#       Value:
#           0 (false)
#           1 (true)
#

StarterGuild.Announce = 0

#
#   StarterGuild.GuildName
#       Description: Name of the staff guild that GM accounts are added to
#       Note: The guild must already exist in the world database with this exact name.
#       Default: "Redscale Staff"
#

StarterGuild.GuildName = "Redscale Staff"

#
#   StarterGuild.WelcomeText
#       Description: Welcome text sent to the player in chat when he is added to the guild. Can be set to not notify, by setting this config to an empty string.
#       Value: Any String, using either {GUILD} or {PLAYER} in your string will cause them to be replaced with the guilds name or characters name respectivly.
#
StarterGuild.WelcomeText = "Welcome to {GUILD}, {PLAYER}."
